# 本地开发：复制为 backend/.env。请勿把真实密钥提交到 Git。
DEMO_SEED=true
SHARD_COUNT=16
QUEUE_BACKEND=local
CACHE_BACKEND=memory
KNOWLEDGE_BACKEND=local
MCP_TRANSPORT=stdio
LLM_MODE=demo

# 方舟控制台创建 API Key，选择支持工具调用的模型。
# LLM_MODE=ark 后启用真实模型；ARK_MODEL 填 Model ID 或 Endpoint ID。
ARK_API_KEY=
ARK_MODEL=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 默认直连方舟。确需继承系统代理时设为 true。
ARK_TRUST_ENV=false

# 支持文本嵌入和 doubao-embedding-vision 多模态嵌入模型。
# auto 按 Model ID 识别接口；多模态 Endpoint ID 请显式设为 multimodal。
ARK_EMBEDDING_MODEL=
ARK_EMBEDDING_API=auto
EMBEDDING_DIMENSION=1024
MILVUS_URI=http://localhost:19531
MILVUS_COLLECTION=industrial_knowledge
MILVUS_TOKEN=

# 使用本项目 Docker Compose 启动基础设施后，可启用以下配置。
# DATABASE_URL=mysql+pymysql://industrial:industrial@localhost:3316/industrial?charset=utf8mb4
RABBITMQ_URL=amqp://industrial:industrial@localhost:5673/
RABBITMQ_QUEUE=industrial.telemetry
REDIS_URL=redis://localhost:16381/0
AGGREGATE_INTERVAL=300
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
